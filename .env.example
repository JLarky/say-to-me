# VAPID keys for Web Push notifications (background push when tab is closed)
# Generate with: node -e "const wp = require('web-push'); const k = wp.generateVAPIDKeys(); console.log('VAPID_PUBLIC_KEY=' + k.publicKey + '\nVAPID_PRIVATE_KEY=' + k.privateKey)"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# Honeycomb API key for OpenTelemetry tracing (optional)
# Get from https://ui.honeycomb.io/account → API Keys
HONEYCOMB_API_KEY=

# Public Say To Me Tailscale hostname; Astro allows this host in dev.
SAY_TO_ME_TAILSCALE_HOST=

# Jinx LLM waiting-state refinement is disabled by default to avoid spend.
# Leave false to use heuristic waiting-state labels; set to true only to opt in.
SAY_TO_ME_JINX=false
