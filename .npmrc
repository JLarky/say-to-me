@jsr:registry=https://npm.jsr.io
engine-strict=true
# nub uses isolated pnpm-style linking by default; hoisted matches npm's layout
node-linker=hoisted
link-workspace-packages=true
defaultTrust=false
# exact-mirror (elysia's peer dep) lost provenance metadata between 0.2.6 and
# 1.2.4; nub's trust-downgrade gate would otherwise block installs
trustPolicyExclude=exact-mirror@1.2.4
