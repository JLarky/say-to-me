{
  "name": "say-to-me2",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Elysia HTTP service: health, OpenAPI, and a Paseo relay probe.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file=.env --watch src/index.ts",
    "dev:node": "node --env-file=.env --watch src/index.ts",
    "dev:bun": "bun --watch src/index.ts",
    "start": "node --env-file=.env src/index.ts",
    "start:node": "node --env-file=.env src/index.ts",
    "start:bun": "bun src/index.ts",
    "lint": "oxlint",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:node": "node --test \"src/**/*.test.ts\"",
    "test:bun": "bun test src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/node": "^1.4.5",
    "@elysiajs/openapi": "^1.4.16",
    "@sinclair/typebox": "^0.34.52",
    "@t3-oss/env-core": "^0.13.11",
    "effect": "4.0.0-rc.115",
    "elysia": "^1.4.30",
    "openapi-types": "^12.1.3"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.83.0",
    "@types/node": "^26.5.1",
    "oxlint": "1.83.0",
    "typescript": "^7.0.2"
  }
}
