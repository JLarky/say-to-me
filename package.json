{
  "name": "say-to-me",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/JLarky/say-to-me.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vp exec astro dev --background",
    "dev-or-follow": "vp run dev && vp exec astro dev logs --follow",
    "check": "vp check",
    "test": "vp run --filter \"./packages/*\" test && vp test --project shared-modules && vp test --project isolated-env",
    "build": "vp build",
    "build:web": "astro build",
    "verify:voice-markdown-browser": "node scripts/verify-voice-markdown-browser.ts",
    "preview": "node server/index.js",
    "preview:web": "node ./dist/server/entry.mjs",
    "booo": "node server/boo/cli.ts",
    "mcp:boo": "node server/boo/mcp.ts",
    "db:compat": "node scripts/check-db-compat.ts",
    "db:export": "node scripts/export-db.ts",
    "db:backup": "node scripts/backup-db.ts",
    "db:generate": "drizzle-kit generate",
    "prepare": "vp config && effect-language-service patch"
  },
  "dependencies": {
    "@astrojs/node": "^11.0.0",
    "@astrojs/react": "^6.0.0",
    "@effect/platform": "^0.96.1",
    "@effect/platform-node": "^0.107.0",
    "@lift-html/solid": "^0.0.6",
    "@opencode-ai/sdk": "^1.14.50",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/context-zone": "^2.7.1",
    "@opentelemetry/core": "^2.7.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.218.0",
    "@opentelemetry/instrumentation": "^0.218.0",
    "@opentelemetry/instrumentation-fetch": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/sdk-trace-web": "^2.7.1",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@say-to-me/completion-watch": "0.1.0",
    "@say-to-me/external-cli-delivery": "0.1.0",
    "@say-to-me/opencode-delivery": "0.1.0",
    "@say-to-me/provider-models": "0.1.0",
    "@say-to-me/routines": "0.1.0",
    "@say-to-me/runtime-validation": "0.1.0",
    "@say-to-me/session-utils": "0.1.0",
    "@sinclair/typebox": "^0.34.52",
    "@stylexjs/stylex": "^0.18.3",
    "@vitejs/plugin-react": "latest",
    "arktype": "^2.2.0",
    "astro": "7.1.3",
    "better-sqlite3": "^12.10.1",
    "drizzle-orm": "^0.45.2",
    "effect": "^3.21.2",
    "elysia": "^1.4.29",
    "esbuild": "^0.28.1",
    "esbuild-plugin-solid": "^0.6.0",
    "express": "latest",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^7.15.1",
    "sanitize-html": "^2.17.6",
    "satteri": "^0.9.5",
    "sharp": "^0.34.5",
    "solid-js": "^1.9.14",
    "undici": "^7.0.0",
    "unplugin": "^2.3.11",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.0",
    "@jlarky/gha-ts": "npm:@jsr/jlarky__gha-ts@^0.2.2",
    "@oxlint/plugins": "1.78.0",
    "@stylexjs/babel-plugin": "^0.18.3",
    "@stylexjs/eslint-plugin": "^0.18.3",
    "@stylexjs/unplugin": "^0.18.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "^2.16.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "oxlint": "1.78.0",
    "typescript": "^6.0.3",
    "vite-plugin-solid": "^2.11.14",
    "vite-plus": "latest",
    "yaml": "^2.9.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "vite": "npm:@voidzero-dev/vite-plus-core@latest",
      "@opencode-ai/sdk": "1.14.50"
    },
    "allowBuilds": {
      "better-sqlite3": true,
      "esbuild": true,
      "sharp": true,
      "protobufjs": true,
      "@parcel/watcher": true,
      "msgpackr-extract": false
    }
  }
}
