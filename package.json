{
  "name": "say-to-me2",
  "version": "0.1.0",
  "private": true,
  "description": "Local Elysia HTTP service: health, OpenAPI, a relay WebSocket round-trip, and an in-process Specter paired-clients slice.",
  "bin": {
    "say-to-me2": "./bin/say-to-me2"
  },
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch src/index.ts",
    "dev:node": "node --env-file=.env --watch src/index.ts",
    "dev:bun": "bun --watch src/index.ts",
    "start": "node --env-file=.env src/index.ts",
    "start:node": "node --env-file=.env src/index.ts",
    "start:bun": "bun src/index.ts",
    "check": "vp check",
    "lint": "vp lint",
    "test": "node --test \"src/**/*.test.ts\"",
    "test:node": "node --test \"src/**/*.test.ts\"",
    "test:bun": "bun test src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/node": "^1.4.5",
    "@elysiajs/openapi": "^1.4.16",
    "@sinclair/typebox": "^0.34.52",
    "@specter-ts/core": "0.2.1",
    "@standard-schema/spec": "^1.1.0",
    "@t3-oss/env-core": "^0.13.11",
    "effect": "4.0.0-rc.115",
    "elysia": "^1.4.30",
    "openapi-types": "^12.1.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@jlarky/gha-ts": "npm:@jsr/jlarky__gha-ts@^0.2.2",
    "@oxlint/plugins": "1.83.0",
    "@types/node": "^26.5.1",
    "@types/ws": "^8.18.1",
    "oxlint": "1.83.0",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "latest",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=24"
  }
}
